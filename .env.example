# Platform accounts on the web. Generate a unique secret with openssl rand -hex 32.
DATABASE_URL=postgresql://studio:studio@127.0.0.1:5432/studio
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
PLATFORM_STARTER_CREDITS=25
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=studio@example.test
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional. Set only to a header overwritten with one client IP by your trusted reverse proxy.
AUTH_TRUSTED_IP_HEADER=

# Per-plan storage (MiB), voice minutes per calendar month, and simultaneous jobs.
PLATFORM_FREE_STORAGE_MIB=512
PLATFORM_PREMIUM_STORAGE_MIB=10240
PLATFORM_FREE_VOICE_MINUTES=5
PLATFORM_PREMIUM_VOICE_MINUTES=60
PLATFORM_FREE_CONCURRENT_JOBS=1
PLATFORM_PREMIUM_CONCURRENT_JOBS=3

# Private project objects. Use a durable directory outside public/ for local mode.
PLATFORM_PROJECT_STORAGE=local
PLATFORM_PROJECT_ROOT=.private-projects
# For s3 mode, supply a private bucket and a path-style endpoint.
# PLATFORM_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# PLATFORM_S3_BUCKET=studio-private-projects
# PLATFORM_S3_REGION=us-east-1
# PLATFORM_S3_ACCESS_KEY=
# PLATFORM_S3_SECRET_KEY=
# PLATFORM_S3_SESSION_TOKEN=
